# ==============================================================================
# OpsMesh — Environment Configuration (.env.example)
# ==============================================================================
# Copie este arquivo para .env e preencha com as credenciais adequadas.
# Nunca comite o arquivo .env no Git!
# ==============================================================================

# --- Aplicação e Ambiente ---
APP_ENV=development
LOG_LEVEL=INFO
API_PORT=8000
API_HOST=0.0.0.0
WEBHOOK_SECRET=opsmesh-webhook-secret-key-change-in-prod

# --- Modelos de Linguagem (Google Gemini / DeepSeek / OpenAI / OpenCode Go) ---
# Opção 1: Google Gemini Pro (Aproveitando sua cota Gemini via endpoint OpenAI)
GEMINI_API_KEY=AIzaSy...
GEMINI_MODEL_NAME=gemini-1.5-flash

# Opção 2: DeepSeek ou OpenCode Go (Compatível com spec OpenAI)
DEEPSEEK_API_KEY=sk-...
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL_NAME=deepseek-chat

# Opção 3: OpenAI Direto
OPENAI_API_KEY=sk-...
OPENAI_MODEL_NAME=gpt-4o-mini

# Provedor padrão ativo ("gemini", "deepseek" ou "openai")
DEFAULT_LLM_PROVIDER=deepseek

# --- Segurança CORS (Domínios autorizados, separados por vírgula ou * para público) ---
CORS_ORIGINS=*

# --- Persistência de Checkpoints (PostgreSQL Serverless: Neon / Supabase) ---
# Formato: postgresql+asyncpg://user:password@host:port/dbname?sslmode=require
DATABASE_URL=postgresql+asyncpg://neondb_owner:password@ep-cool-frost-123456.us-east-2.aws.neon.tech/neondb?sslmode=require

# --- Banco Vetorial (Qdrant: Local ou Cloud Free Tier) ---
QDRANT_LOCATION=:memory:
# Para Qdrant Cloud:
# QDRANT_URL=https://xyz-example.eu-central.aws.cloud.qdrant.io:6333
# QDRANT_API_KEY=thIsIsAnApiKey...

# --- FinOps & Blindagem Anti-DoW (Denial of Wallet) ---
DEMO_MODE=false
# Se DEMO_MODE=replay, os 4 cenários usam rastros pré-gravados do LogHub (custo zero)
FINOPS_DAILY_BUDGET_USD=1.00
FINOPS_DAILY_TOKEN_LIMIT=150000
FINOPS_MAX_TOKENS_PER_INCIDENT=12000
FINOPS_MAX_SUPERVISOR_ITERATIONS=4
RATE_LIMIT_PER_MINUTE=5

# --- Observabilidade de LLMs (LangSmith) ---
LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=lsv2_pt_...
LANGSMITH_PROJECT=opsmesh

# --- Observabilidade Alternativa (Langfuse - Opcional) ---
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...
LANGFUSE_HOST=https://cloud.langfuse.com
